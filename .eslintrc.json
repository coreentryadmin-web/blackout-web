{
  "extends": "next/core-web-vitals",
  "plugins": ["jsx-a11y", "tailwindcss", "@typescript-eslint"],
  "rules": {
    "tailwindcss/enforces-shorthand": "warn",
    "tailwindcss/no-contradicting-classname": "warn",
    "tailwindcss/no-custom-classname": "off",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/anchor-has-content": "warn",
    "jsx-a11y/anchor-is-valid": "warn",
    "jsx-a11y/aria-props": "warn",
    "jsx-a11y/aria-proptypes": "warn",
    "jsx-a11y/aria-role": "warn",
    "jsx-a11y/aria-unsupported-elements": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "jsx-a11y/role-supports-aria-props": "warn",
    "jsx-a11y/no-redundant-roles": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/mouse-events-have-key-events": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    "jsx-a11y/interactive-supports-focus": "warn",
    "jsx-a11y/tabindex-no-positive": "warn"
  },
  "overrides": [
    {
      "files": ["src/features/**/*.tsx", "src/components/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/*-server", "**/*-server.ts"],
                "message": "Client components (\"use client\") must not import *-server modules directly. Server-only modules (guarded by `import \"server-only\";`) pull in Node-only/WS/DB machinery that breaks the client bundle if it leaks into a component tree — this is the exact regression class that broke the build in PR #1708. Fetch the data through an API route/server action instead, or import a shared non-server \"-core\" module if the logic is safe to run on the client."
              }
            ]
          }
        ]
      }
    }
  ]
}
