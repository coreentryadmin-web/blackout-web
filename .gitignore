.env
.env.production
.env.local
.env*.local
production.env
staging.env
railway-*.env
# No trailing slash (unlike a plain "node_modules/" directory-only pattern):
# this repo has shipped a committed node_modules SYMLINK before (2026-08-08,
# self-referential -> broke every fresh checkout with ELOOP) precisely because
# a directory-only ignore pattern does not match a symlink, so a broad
# `git add -A` staged it anyway. Matching files/symlinks too closes that hole.
node_modules
.next/
out/
build/
.DS_Store
*.log
_logs_*.txt
tsconfig.tsbuildinfo

# clerk configuration (can include secrets)
/.clerk/

# data-validator runtime output (may contain live production data)
audit-output/

# iOS Capacitor (generated / local)
apps/blackout-ios/node_modules
apps/blackout-ios/ios/
# Stale clone of deprecated standalone repo (root only — not apps/blackout-ios/)
/blackout-ios/

# AWS infra — separate repo (blackout-infra), own git remote
/blackout-infra/

# Claude Code transient git worktrees (never commit these)
.claude/worktrees/

# Root-level transient git worktrees created by background agents (never commit)
.worktrees/

# BIE eval harness run artifacts (stable scorecard + output dir)
scripts/bie-eval/last-scorecard.json
bie-eval-out/
artifacts/

# Playwright MCP / ad-hoc UI capture (never commit)
.playwright-mcp/
auth-landing.png
nighthawk-live.png
spx-dashboard-pin.png

thermal-after-refresh.png
thermal-triple-after-load.png
